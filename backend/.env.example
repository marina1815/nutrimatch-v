APP_ENV=development
APP_PORT=8080

DATABASE_URL=postgres://app:password123@localhost:5432/nutrimatch?sslmode=disable
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://postgres:postgres@localhost:5432/nutrimatch?sslmode=disable

JWT_SECRET=replace-with-32-char-minimum-secret-key
JWT_ISSUER=nutrimatch
JWT_AUDIENCE=nutrimatch_users
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=720
REFRESH_TOKEN_PEPPER=replace-with-separate-32-char-pepper
HEALTH_DATA_ENCRYPTION_KEY=replace-with-exactly-32-char-key
MFA_SECRET_ENCRYPTION_KEY=replace-with-exactly-32-char-mfa-key
SENSITIVE_DATA_INDEX_KEY=replace-with-32-char-blind-index-key

ARGON2_TIME=2
ARGON2_MEMORY=65536
ARGON2_THREADS=4
ARGON2_KEY_LENGTH=32
ARGON2_SALT_LENGTH=16

COOKIE_NAME_REFRESH=nm_refresh
COOKIE_NAME_CSRF=nm_csrf
