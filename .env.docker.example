# NutriMatch Docker environment example
# Copy this file to ".env" at the project root before running Docker Compose.
# Local demo command:
#   Windows PowerShell: Copy-Item .env.docker.example .env
#   Linux/macOS:        cp .env.docker.example .env
#
# These defaults are intentionally portable: no personal path, no machine-specific value.
# For a real deployment, replace every demo secret in the "Application secrets" section.

APP_ENV=development

# Ports exposed on the host machine.
POSTGRES_PORT=5432
API_PORT=8080
FRONTEND_PORT=3000

# PostgreSQL Docker database.
# The "postgres" account is used by the db/migration container.
# The "app" account is used by the API with reduced privileges.
POSTGRES_DB=nutrimatch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
APP_DB_USER=app
APP_DB_PASSWORD=password123

# Application secrets.
# Local demo values work, but they must be replaced before any real deployment.
JWT_SECRET=dev-jwt-secret-change-me-64-characters-minimum-value
REFRESH_TOKEN_PEPPER=dev-refresh-token-pepper-change-me-64-characters-value
HEALTH_DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
MFA_SECRET_ENCRYPTION_KEY=abcdef0123456789abcdef0123456789
SENSITIVE_DATA_INDEX_KEY=fedcba9876543210fedcba9876543210

# Local browser/API origins.
CORS_ORIGINS=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
CSP_UPGRADE_INSECURE_REQUESTS=false

# Redis is internal to Docker Compose.
RATE_LIMIT_STORE=redis
REDIS_URL=redis://redis:6379/0

# Local HTTP cookies. For HTTPS production, set COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
COOKIE_PATH_REFRESH=/

# Optional Google AI.
# Leave GOOGLE_AI_API_KEY empty if you only want deterministic backend-safe recipes.
# If filled, the AI explains/validates recipes already filtered by the backend.
GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.5-flash

# Optional OIDC.
# Leave all OIDC variables empty unless you have configured a provider.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:8080/api/v1/auth/oidc/callback
OIDC_SCOPES=openid,profile,email
OIDC_PROVIDER_NAME=oidc
OIDC_FRONTEND_SUCCESS_URL=http://localhost:3000/auth/oidc/callback

# Local WebAuthn/passkeys.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_DISPLAY_NAME=NutriMatch
WEBAUTHN_ORIGINS=http://localhost:3000
